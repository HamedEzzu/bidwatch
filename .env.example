# BidWatch environment configuration.
# Copy to .env and fill in. BidWatch still runs end-to-end with none of these:
# with no Telegram credentials it prints notifications and the prepared
# application package to the console (`--interactive`).

# --- Telegram (job alerts and the Bid / Open / Skip buttons) ---------------
# Token from @BotFather (Telegram -> @BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=
# Your chat id: message the bot once, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id
TELEGRAM_CHAT_ID=

# BidWatch prepares applications and hands them to you; it never sends mail
# and never submits a form, so no SMTP or browser credentials are needed.

# --- Optional -------------------------------------------------------------
# Overrides for the defaults in config.py
# AWS_REGION=eu-north-1
# BIDWATCH_MODEL_ID=zai.glm-5
# BIDWATCH_TAG=backend
# SCORE_THRESHOLD=65
# MAX_POSTINGS_PER_RUN=15
# RUN_INTERVAL_MINUTES=30
