# BidWatch environment configuration.
# Copy to .env and fill in. BidWatch still runs end-to-end with none of these:
# with no Telegram credentials it prints notifications to the console and the
# bid flow runs as terminal prompts (`--interactive`).

# --- Telegram (job alerts and the Bid / Open / Skip buttons) ---------------
# Token from @BotFather (Telegram -> @BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=
# Your chat id: message the bot once, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id
TELEGRAM_CHAT_ID=

# --- SMTP (used only to send an application you explicitly confirmed) ------
# Gmail: host smtp.gmail.com, port 587, and an App Password as SMTP_PASS
# (a normal account password will not work with 2FA enabled).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address applications are sent from. Defaults to SMTP_USER when unset.
FROM_EMAIL=

# --- Optional -------------------------------------------------------------
# Greenhouse board token, if you have one; without it Greenhouse jobs fall
# back to the manual handoff path.
# GREENHOUSE_API_TOKEN=

# Overrides for the defaults in config.py
# AWS_REGION=eu-north-1
# BIDWATCH_MODEL_ID=zai.glm-5
# BIDWATCH_TAG=backend
# SCORE_THRESHOLD=65
# MAX_POSTINGS_PER_RUN=15
# MAX_SUBMISSIONS_PER_HOUR=5
# RUN_INTERVAL_MINUTES=30
