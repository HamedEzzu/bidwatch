# BidWatch environment configuration.
# Copy to .env and fill in. BidWatch runs end-to-end without any of these:
# with no Telegram credentials it prints notifications to the console.

# Telegram bot token from @BotFather (Telegram -> @BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=

# Your chat id: message the bot once, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id
TELEGRAM_CHAT_ID=

# Optional overrides (defaults live in config.py)
# AWS_REGION=eu-north-1
# BIDWATCH_MODEL_ID=zai.glm-5
# BIDWATCH_TAG=backend
# SCORE_THRESHOLD=65
# MAX_POSTINGS_PER_RUN=5
# RUN_INTERVAL_MINUTES=30
